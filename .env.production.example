# DFAT Production Environment Configuration
# Copy to .env.production.local and fill in real values.
# Generate secrets with: bash scripts/generate_secrets.sh

# Environment identifier (must be "production")
DFAT_ENV=production

# JWT secret — generate with: openssl rand -hex 32
DFAT_JWT_SECRET=generate-with-openssl-rand-hex-32

# Database URL
DFAT_DATABASE_URL=sqlite+aiosqlite:///var/lib/dfat/dfat.db

# Logging
DFAT_LOG_LEVEL=WARNING
DFAT_AUDIT_LOG_PATH=/var/log/dfat/audit.log

# Storage paths
DFAT_EVIDENCE_DIR=/var/lib/dfat/evidence
DFAT_OUTPUT_DIR=/var/lib/dfat/reports

# Ollama LLM endpoint (Docker service name)
DFAT_LLM_API_URL=http://ollama:11434

# CORS — JSON array of allowed origins
DFAT_CORS_ORIGINS=["https://dfat.example.com"]
