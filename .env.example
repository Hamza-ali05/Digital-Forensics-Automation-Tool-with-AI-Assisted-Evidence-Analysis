# DFAT environment template — copy to .env and adjust per environment.
# Nested keys use DFAT_ prefix and __ delimiter (see src/dfat/settings.py).

# --- Core ---
DFAT_ENV=development

# --- Logging ---
DFAT_LOGGING__LOG_LEVEL=INFO
DFAT_LOGGING__AUDIT_LOG_PATH=./data/outputs/audit.log
DFAT_LOGGING__LOG_FORMAT=json

# --- Database ---
DFAT_DATABASE__URL=sqlite+aiosqlite:///./data/dfat.db
# Production example:
# DFAT_DATABASE__URL=postgresql+asyncpg://dfat:change-me@db:5432/dfat
DFAT_DATABASE__CREATE_TABLES_ON_STARTUP=true

# --- Authentication (change before production) ---
DFAT_AUTH__SECRET_KEY=your-secret-key-here-generate-with-openssl
DFAT_AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=60
DFAT_AUTH__REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Local LLM (loopback only — ADR-017) ---
DFAT_AI_ENGINE__LLM_API_URL=http://127.0.0.1:11434/api/generate
DFAT_AI_ENGINE__LLM_MODEL=llama3
DFAT_AI_ENGINE__TEMPERATURE=0.1
DFAT_AI_ENGINE__ENABLE_FALLBACK=true

# --- Evidence and outputs ---
DFAT_EVIDENCE__EVIDENCE_DIR=./data/evidence
DFAT_REPORTING__OUTPUT_DIR=./data/outputs

# --- API / CORS ---
# JSON array; production should list HTTPS origins only.
DFAT_API__CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Legacy shorthand (optional; prefer nested keys above) ---
DFAT_LOG_LEVEL=INFO
DFAT_EVIDENCE_DIR=./data/evidence
DFAT_OUTPUT_DIR=./data/outputs
