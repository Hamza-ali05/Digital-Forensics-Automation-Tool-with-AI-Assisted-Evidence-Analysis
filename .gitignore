# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
*.egg
dist/
build/
.venv/
venv/
env/

# Environment / secrets (keep example templates tracked)
.env
.env.local
.env.*.local
.env.production
!.env.example
!.env.production.example
*.pem
*.key
credentials.json
secrets.json

# Tooling caches & coverage
.mypy_cache/
.pytest_cache/
.pytest_tmp/
.pytest_tmp*/
.ruff_cache/
.cache/
.coverage
.coverage.*
coverage.xml
coverage.json
coverage_boost.json
coverage_fe.json
htmlcov/
coverage/
.tox/
.nox/
.hypothesis/
.dmypy.json
dmypy.json

# Generated reports
reports/

# Frontend (CRA / npm) — also covered by frontend/.gitignore
frontend/node_modules/
frontend/build/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.development.local
frontend/.env.production
frontend/.env.production.local
frontend/.env.test
frontend/.env.test.local
!frontend/.env.example

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp
*.log
*.tmp
*.bak
tmp/
temp/
logs/

# Launcher / local runtime state
.dfat/
.dfat_backend.pid
.dfat_frontend.pid

# Runtime / forensic data (local only — keep .gitkeep placeholders)
data/evidence/*
data/datasets/*
data/outputs/*
data/questionnaire/responses/*
data/knowledge/*
data/ml/*
data/e2e/*
!data/evidence/.gitkeep
!data/datasets/.gitkeep
!data/outputs/.gitkeep
!data/questionnaire/.gitkeep
!data/questionnaire/responses/.gitkeep
!data/ground_truth/.gitkeep
!data/knowledge/.gitkeep
!data/ml/.gitkeep
!data/e2e/.gitkeep

# Forensic image / dump patterns
*.dd
*.raw
*.E01
*.e01
*.vmem
*.mem
*.aff
*.vmdk
*.vhd
*.vhdx

# Local SQLite databases
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Scaffold / one-off verify scripts
_prompt1_scaffold.py
_verify_*.py
