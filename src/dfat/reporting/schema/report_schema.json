{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dfat.local/schemas/forensic_report.schema.json",
  "title": "DFAT Forensic Report Schema",
  "description": "Structured JSON artefact output layer (schema_version 1.0.0). Primary evidential record (Scanlon et al., 2023).",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "evidence_id",
    "case_metadata",
    "generated_at",
    "integrity_hash",
    "pipeline_stage_timings",
    "artefacts",
    "summary_statistics",
    "ai_metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "case_metadata": {
      "type": "object",
      "required": ["case_id", "case_name", "investigator"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "case_name": { "type": "string", "minLength": 1 },
        "investigator": { "type": "string", "minLength": 1 }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "integrity_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "pipeline_stage_timings": {
      "type": "object",
      "required": [
        "acquisition_seconds",
        "parsing_seconds",
        "triage_seconds",
        "reporting_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "acquisition_seconds": { "type": "number", "minimum": 0 },
        "parsing_seconds": { "type": "number", "minimum": 0 },
        "triage_seconds": { "type": "number", "minimum": 0 },
        "reporting_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "artefacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artefact_id",
          "category",
          "raw_data"
        ],
        "additionalProperties": false,
        "properties": {
          "artefact_id": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "filesystem_metadata",
              "registry_key",
              "browser_history",
              "event_log",
              "running_process",
              "network_connection",
              "injected_code"
            ]
          },
          "source_path": { "type": ["string", "null"] },
          "suspicion_level": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "informational"]
          },
          "relevance_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "raw_data": { "type": "object" },
          "classification_reasoning": { "type": ["string", "null"] },
          "metadata": { "type": "object" }
        }
      }
    },
    "summary_statistics": {
      "type": "object",
      "required": ["total_artefacts", "by_category", "by_suspicion_level"],
      "additionalProperties": false,
      "properties": {
        "total_artefacts": { "type": "integer", "minimum": 0 },
        "by_category": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "by_suspicion_level": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "ai_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_used": { "type": "string" },
        "prompt_version": { "type": "string" },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "analysis_mode": {
          "type": "string",
          "enum": ["rule_based", "llm", "hybrid", "none"]
        },
        "disclaimer": { "type": "string" }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artefact_data_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "input_evidence_hash": { "type": "string" },
        "tool_version": { "type": "string" },
        "schema_version": { "type": "string" }
      }
    },
    "audit_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generated_by_user_id": { "type": "string" },
        "pipeline_job_id": { "type": "string" },
        "custody_chain_entries": { "type": "integer", "minimum": 0 },
        "tool_version": { "type": "string" },
        "generation_host": { "type": "string" },
        "generation_timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
