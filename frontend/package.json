{
  "name": "dfat-frontend",
  "description": "DFAT — Digital Forensics Automation Tool Frontend",
  "author": "DFAT",
  "keywords": [
    "dfat",
    "digital forensics",
    "react",
    "bootstrap 5"
  ],
  "license": "MIT",
  "homepage": ".",
  "version": "0.1.0",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-brands-svg-icons": "^5.15.4",
    "@fortawesome/free-regular-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.1.17",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.3.2",
    "@testing-library/user-event": "^7.1.2",
    "@themesberg/react-bootstrap": "^1.4.1",
    "axios": "^1.19.0",
    "bootstrap": "5.0.0-beta1",
    "chart.js": "^3.9.1",
    "chartist": "^0.11.4",
    "chartist-plugin-tooltips-updated": "^0.1.4",
    "moment-timezone": "^0.5.31",
    "react": "^16.13.1",
    "react-chartist": "^0.14.4",
    "react-chartjs-2": "^3.3.0",
    "react-copy-to-clipboard": "^5.0.3",
    "react-datetime": "^3.0.4",
    "react-dom": "^16.13.1",
    "react-github-btn": "^1.2.0",
    "react-live": "^2.2.3",
    "react-router-dom": "^5.2.0",
    "react-router-hash-link": "^2.3.1",
    "react-scripts": "3.4.3",
    "react-transition-group": "^4.4.1",
    "sass": "1.32.13",
    "simplebar-react": "^2.3.0"
  },
  "scripts": {
    "start": "set NODE_OPTIONS=--openssl-legacy-provider&& react-scripts start",
    "build": "set NODE_OPTIONS=--openssl-legacy-provider&& react-scripts build",
    "build-local": "set NODE_OPTIONS=--openssl-legacy-provider&& set PUBLIC_URL=./&& react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:pages": "react-scripts test --watchAll=false --testPathPattern=src/__tests__/pages",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "eject": "react-scripts eject"
  },
  "jest": {
    "moduleNameMapper": {
      "^axios$": "<rootDir>/src/test-utils/axios-cjs.js"
    },
    "collectCoverageFrom": [
      "src/services/**/*.{js,jsx}",
      "src/hooks/**/*.{js,jsx}",
      "src/guards/**/*.{js,jsx}",
      "src/utils/formatters.js",
      "src/utils/validators.js",
      "src/utils/constants.js",
      "src/utils/permissions.js",
      "src/utils/artefactLoader.js",
      "src/pages/auth/Login.js",
      "src/pages/cases/CaseList.js",
      "src/pages/evidence/EvidenceDetail.js",
      "src/pages/pipeline/PipelineDetail.js",
      "src/pages/artefacts/ArtefactExplorer.js",
      "src/pages/ai/AIAnalysis.js",
      "src/pages/reports/ReportDetail.js",
      "src/pages/dashboard/Dashboard.js",
      "src/pages/evaluation/BenchmarkResults.js",
      "src/pages/evaluation/Questionnaire.js",
      "src/components/common/StatusBadge.js",
      "src/components/forensic/StatusTimeline.js",
      "src/components/forensic/ChatInterface.js",
      "!src/**/*.test.js",
      "!src/__tests__/**",
      "!src/test-utils/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 0
      },
      "./src/services/": {
        "statements": 75
      },
      "./src/pages/": {
        "statements": 60
      }
    }
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.1",
    "http-proxy-middleware": "^4.2.0",
    "msw": "^1.3.5"
  }
}
