# Relative URL uses setupProxy.js in development (avoids CORS).
# For production or direct backend access, use http://localhost:8000/api/v1
REACT_APP_API_BASE_URL=/api/v1
REACT_APP_APP_NAME=DFAT
REACT_APP_APP_VERSION=0.1.0
REACT_APP_TOKEN_REFRESH_INTERVAL_MS=300000
REACT_APP_POLLING_INTERVAL_MS=5000
REACT_APP_MAX_FILE_SIZE_MB=500
